------------------------------\",\"variant\":\"intro\"},{\"id\":49,\"type\":\"system\",\"text\":\"06:42 \\u2014 B\\u1ea1n t\\u1edbi v\\u00e0 phong t\\u1ecfa hi\\u1ec7n tr\\u01b0\\u1eddng c\\u0103n h\\u1ed9 17B.\",\"variant\":\"intro\"},{\"id\":50,\"type\":\"system\",\"text\":\"N\\u1ea1n nh\\u00e2n: Ethan Ward, nh\\u00e0 b\\u00e1o \\u0111i\\u1ec1u tra.\",\"variant\":\"intro\"},{\"id\":51,\"type\":\"system\",\"text\":\"Th\\u1eddi gian t\\u1eed vong \\u01b0\\u1edbc t\\u00ednh: 01:10\\u201301:35.\",\"variant\":\"intro\"},{\"id\":52,\"type\":\"system\",\"text\":null,\"variant\":\"intro\"},{\"id\":53,\"type\":\"system\",\"text\":\"Laptop c\\u1ee7a Ethan \\u0111ang ho\\u1ea1t \\u0111\\u1ed9ng c\\u1ea1nh n\\u1ea1n nh\\u00e2n. \\u1ed4 ngu\\u1ed3n tin m\\u00e3 h\\u00f3a \\u0111\\u00e3 bi\\u1ebfn m\\u1ea5t.\",\"variant\":\"intro\"},{\"id\":54,\"type\":\"system\",\"text\":\"B\\u1ea1n k\\u1ebft n\\u1ed1i laptop v\\u1edbi thi\\u1ebft b\\u1ecb ph\\u00e1p y \\u1edf ch\\u1ebf \\u0111\\u1ed9 ch\\u1ec9 \\u0111\\u1ecdc.\",\"variant\":\"intro\"},{\"id\":55,\"type\":\"system\",\"text\":\"M\\u1ecdi thao t\\u00e1c ghi l\\u00ean \\u1ed5 \\u0111\\u0129a g\\u1ed1c \\u0111\\u1ec1u b\\u1ecb kh\\u00f3a \\u0111\\u1ec3 b\\u1ea3o to\\u00e0n ch\\u1ee9ng c\\u1ee9.\",\"variant\":\"intro\"},{\"id\":56,\"type\":\"system\",\"text\":\"Tin nh\\u1eafn kh\\u00f4i ph\\u1ee5c cho th\\u1ea5y bi\\u00ean t\\u1eadp vi\\u00ean Claire Bennett c\\u00f3 th\\u1ec3 \\u0111\\u00e3 b\\u1ecb b\\u1eaft c\\u00f3c v\\u00e0 v\\u1eabn c\\u00f2n s\\u1ed1ng.\",\"variant\":\"intro\"},{\"id\":57,\"type\":\"system\",\"text\":\"M\\u1ed9t k\\u1ebb n\\u00e0o \\u0111\\u00f3 \\u0111\\u00e3 s\\u1eed d\\u1ee5ng tr\\u00e1i ph\\u00e9p t\\u00e0i kho\\u1ea3n thu\\u1ed9c h\\u1ec7 th\\u1ed1ng v\\u1eadt ch\\u1ee9ng c\\u1ee7a c\\u1ea3nh s\\u00e1t \\u0111\\u1ec3 x\\u00f3a d\\u1ea5u v\\u1ebft.\",\"variant\":\"intro\"},{\"id\":58,\"type\":\"system\",\"text\":null,\"variant\":\"intro\"},{\"id\":59,\"type\":\"system\",\"text\":\"M\\u00c1Y TR\\u1ea0M \\