},{\"id\":55,\"type\":\"system\",\"text\":null,\"variant\":\"intro\"},{\"id\":56,\"type\":\"system\",\"text\":\"M\\u00c1Y TR\\u1ea0M \\u0110ANG S\\u1eec D\\u1ee4NG: PFT-04, m\\u00e1y tr\\u1ea1m ph\\u00e1p y di \\u0111\\u1ed9ng c\\u1ee7a c\\u1ea3nh s\\u00e1t.\",\"variant\":\"intro\"},{\"id\":57,\"type\":\"system\",\"text\":\"B\\u1ea1n \\u0111ang nh\\u1eadp l\\u1ec7nh tr\\u00ean PFT-04, kh\\u00f4ng ph\\u1ea3i tr\\u1ef1c ti\\u1ebfp tr\\u00ean laptop c\\u1ee7a Ethan.\",\"variant\":\"intro\"},{\"id\":58,\"type\":\"system\",\"text\":\"Laptop c\\u1ee7a Ethan, mang m\\u00e3 v\\u1eadt ch\\u1ee9ng EW-LAPTOP-01, \\u0111\\u01b0\\u1ee3c g\\u1eafn ch\\u1ec9 \\u0111\\u1ecdc t\\u1ea1i \\/laptop.\",\"variant\":\"intro\"},{\"id\":59,\"type\":\"system\",\"text\":\"C\\u00e1c th\\u01b0 m\\u1ee5c c\\u1ea5p cao kh\\u00e1c l\\u00e0 ngu\\u1ed3n ch\\u1ee9ng c\\u1ee9 b\\u00ean ngo\\u00e0i do c\\u1ea3nh s\\u00e1t g\\u1eafn v\\u00e0o m\\u00e1y tr\\u1ea1m; ch\\u00fang kh\\u00f4ng n\\u1eb1m tr\\u00ean laptop c\\u1ee7a n\\u1ea1n nh\\u00e2n.\",\"variant\":\"intro\"},{\"id\":60,\"type\":\"system\",\"text\":\"\\u0110\\u1ecdc \\/CASE-BRIEF.txt \\u0111\\u1ec3 n\\u1eafm t\\u00ecnh ti\\u1ebft ban \\u0111\\u1ea7u, ng\\u01b0\\u1eddi li\\u00ean quan v\\u00e0 m\\u1ee5c ti\\u00eau \\u0111i\\u1ec1u tra.\",\"variant\":\"intro\"},{\"id\":61,\"type\":\"system\",\"text\":\"\\u0110\\u1ecdc \\/README.txt \\u0111\\u1ec3 bi\\u1ebft m\\u1ed7i th\\u01b0 m\\u1ee5c l\\u1ea5y d\\u1eef li\\u1ec7u t\\u1eeb \\u0111\\u00e2u.\",\"variant\":\"intro\"},{\"id\":62,\"type\":\"system\",\"text\":\"H\\u00e3y \\u0111\\u1ed1i chi\\u1ebfu \\u0111\\u1ed9c l\\u1eadp ch\\u1ee9ng c\\u1ee9 s\\u1ed1, ch\\u1ee9ng c\\u1ee9 t\\u1ea1i hi\\u1ec7n tr\\u01b0\\u1eddng v\\u00e0 d\\u1eef li\\u1ec7u vi\\u1ec5n th\\u00f4ng.\",\"variant\":\"intro\"},{\"id\":63,\"type\":\"system\",\"text\":\"Lo\\u1ea1i b\\u1ecf c\\u00e1c d\\u1ea5u v\\u1ebft \\u0111\\u00e1nh l\\u1ea1c h\\u01b0\\u1edbng, x\\u00e1c \\u0111\\u1ecbnh hung th\\u1ee7, t\\u00ecm n\\u01a1i Claire b\